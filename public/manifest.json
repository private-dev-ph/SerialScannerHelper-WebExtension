{
  "manifest_version": 3,
  "name": "Serial Scanner Helper",
  "version": "1.0.0",
  "version_name": "1.0",
  "description": "Extract the correct serial value from keyboard-emulating QR scans.",
  "icons": {
    "16": "assets/SerialScannerLogo.png",
    "32": "assets/SerialScannerLogo.png",
    "48": "assets/SerialScannerLogo.png",
    "128": "assets/SerialScannerLogo.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Serial Scanner Helper v1.0",
    "default_icon": {
      "16": "assets/SerialScannerLogo.png",
      "32": "assets/SerialScannerLogo.png",
      "48": "assets/SerialScannerLogo.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "permissions": [
    "storage"
  ]
}
